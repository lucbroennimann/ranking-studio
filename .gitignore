# Installer gehoeren nicht ins Repo. Der Git-Installer lag hier nur
# zum Einrichten herum (65 MB).
*.exe
*.msi

# Windows-Beiwerk
Thumbs.db
desktop.ini

# Lokale Claude-Einstellungen (Rechte, Pfade auf diesem Rechner)
.claude/settings.local.json

# Fertige Videos. Der Browser legt einen Export auch schon mal direkt
# im Projektordner ab, statt in Downloads.
*.mp4

# Schulstoff. Questle liest PDFs und gesicherte Fragensaetze nur lokal ein,
# sie muessen nirgends hin. Das Repo hier ist oeffentlich - eine
# Zusammenfassung aus dem Unterricht gehoert ebensowenig hinein wie die
# Probe darueber.
*.pdf
*.questle.json

# Testfotos fuer den Weinkeller-Viewer. Bleiben lokal, die App speichert
# echte Fotos sowieso nur im Browser des Geraets, nicht im Repo.
weinkeller/Wein-Fotos/
